<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.0</version>
        <relativePath/>
    </parent>

    <groupId>com.agents</groupId>
    <artifactId>agents</artifactId>
    <version>1.0-SNAPSHOT</version>

    <properties>
        <java.version>21</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <spring-ai.version>2.0.0</spring-ai.version>
        <!-- Main class for spring-boot-maven-plugin repackaging (com.agents package, D-17) -->
        <start-class>com.agents.AgentsApplication</start-class>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.ai</groupId>
                <artifactId>spring-ai-bom</artifactId>
                <version>${spring-ai.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- Servlet stack + MVC controllers + embedded Tomcat; natively supports Flux return types for SSE -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Native DeepSeek integration: DeepSeekChatModel, DeepSeekChatOptions, reasoning_content access.
             Uses the dedicated DeepSeek starter (not the OpenAI shim) to preserve reasoning_content field. -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-model-deepseek</artifactId>
        </dependency>

        <!-- CalculatorTool: exp4j 0.4.8 - safe math expression evaluation.
             Uses Dijkstra Shunting Yard algorithm (pure math: no variable assignment, no string ops, no I/O, no reflection).
             ~46KB, no transitive deps. Apache License 2.0 (NOT MIT as stated in CONTEXT.md D-04 -
             clarified in 04-RESEARCH.md §Package Legitimacy Audit; both OSI-approved and compatible with project's Apache 2.0).
             9+ years stable, 13 historical versions. Explicit <version> because not managed by Spring AI BOM or Boot parent. -->
        <dependency>
            <groupId>net.objecthunter</groupId>
            <artifactId>exp4j</artifactId>
            <version>0.4.8</version>
        </dependency>

        <!-- reactor-core comes transitively via the DeepSeek starter above; do NOT add the reactive webflux starter
             (it would trigger WebFlux auto-config and conflict with MVC).
             MCP client starter deferred to Phase 11. -->

        <!-- Spring Framework 7 (via Spring Boot 4.1) provides RetryTemplate in org.springframework.core.retry,
             used by SpringAiRetryAutoConfiguration. No external spring-retry dependency needed. -->

        <!-- Test stack: JUnit 5, Spring Boot Test, AssertJ, Mockito, WebTestClient, reactor-test.
             The parent POM manages the version; we still must declare the dependency. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!-- Exclude tests tagged "integration" by default (DeepSeekIntegrationTest).
                         Avoids: (1) failure when DEEPSEEK_API_KEY not set, (2) reasoner TTFT 3-8s slowing suite.
                         To run integration tests manually, clear the exclusion property on the command line:
                         mvn -B test -Dtest=DeepSeekIntegrationTest with empty excluded groups override. -->
                    <excludedGroups>integration</excludedGroups>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
